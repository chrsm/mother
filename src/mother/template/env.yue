-- template environment builder
import 'mother.template.tags' as tags

-- buffer for collecting rendered HTML
-- used during template execution to accumulate output
export class Buffer
  new: =>
    @parts = {}
    @indent_level = 0
    @indent_str = '  ' -- 2 spaces
  push: (content) =>
    @parts[] = content
  push_line: (content) =>
    indent = @indent_str\rep @indent_level
    @push indent
    @push content
    @push '\n'

  -- increase indent level
  indent: =>
    @indent_level += 1

  -- decrease indent level
  dedent: =>
    @indent_level = math.max 0, @indent_level - 1

  -- get final result
  result: =>
    table.concat @parts

-- create a tag function for the given tag name
make_tag = (name, buffer) ->
  is_void = tags.is_void name

  -- the tag function: (tag attrs?, content_or_fn?)
  -- usage:
  --[[
     div { class: 'box' }, -> h1 'Hello'
     p 'Some text'
     br!
     meta { charset: 'utf-8' }
  ]]
  (...) ->
    args = { ... }
    attrs = nil
    content = nil
    content_fn = nil

    for arg in *args
      t = type arg
      if t == 'table' and not (tags.is_raw arg) and not (getmetatable arg)
        -- plain table = attributes
        attrs = arg unless attrs
      elseif t == 'function'
        content_fn = arg
      elseif t == 'string' or t == 'number'
        content = tags.unwrap arg
      elseif tags.is_raw arg
        content = tags.unwrap arg

    -- render opening tag
    attr_str = tags.render_attrs attrs

    if is_void -- self-closing tags
      buffer\push_line "<#{ name }#{ attr_str }>"
    elseif content_fn
      -- has nested content via function
      buffer\push_line "<#{ name }#{ attr_str }>"
      buffer\indent!
      content_fn!
      buffer\dedent!
      buffer\push_line "</#{ name }>"
    elseif content
      -- rnline content
      indent = buffer.indent_str\rep buffer.indent_level
      buffer\push "#{ indent }<#{ name }#{ attr_str }>#{ content }</#{ name }>\n"
    else
      -- empty tag
      buffer\push_line "<#{ name }#{ attr_str }></#{ name }>"

-- build a template environment with all HTML tags as functions
--
---@param data table Data object accessible in templates
---@param opts table Options { import_template_fn: function }
---@return table + buffer
export build_env = (data = {}, opts = {}) ->
  buffer = Buffer!

  -- direct text/HTML output function - writes directly to buffer
  -- use this to output raw HTML without wrapping in a tag
  -- usage: `text '<p>raw html</p>'` or `text data.post.body`
  text_fn = (content) ->
    if content != nil
      buffer\push tostring content

  env = {
    -- expose data to templates
    data: data

    -- utility functions
    raw: tags.raw -- mark content as raw HTML, won't be escaped by tags
    text: text_fn -- output content directly to buffer
    escape: tags.escape

    -- for debugging
    print: print

    -- common lua functions templates might need
    pairs: pairs
    ipairs: ipairs
    type: type
    tostring: tostring
    tonumber: tonumber
    table: table
    string: string
    math: math
    os: os

    require: require

    -- template importing
    import_template: opts.import_template_fn or (path) ->
      error 'import_template not available in this context'
  }

  -- create tag functions via __index metamethod
  -- this allows any tag name to work, not just predefined ones
  setmetatable env, {
    __index: (t, name) ->
      fn = make_tag name, buffer
      rawset t, name, fn
      fn
  }

  env._env = env

  env, buffer
